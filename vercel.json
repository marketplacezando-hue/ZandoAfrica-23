{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/produit/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|FacebookExternalHit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|Slackbot|Discordbot|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/social-product/:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
